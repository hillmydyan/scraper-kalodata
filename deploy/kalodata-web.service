[Unit]
Description=Kalodata Scraper Web Dashboard (Gunicorn)
After=network.target docker.service kalodata-vnc.service
Wants=docker.service kalodata-vnc.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kalodata
EnvironmentFile=/opt/kalodata/.env
Environment=PYTHONPATH=/opt/kalodata
ExecStart=/opt/kalodata/venv/bin/gunicorn --bind 0.0.0.0:8081 --workers 2 --timeout 180 "app:create_app()"
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
