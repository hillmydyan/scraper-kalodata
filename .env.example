APP_ENV=production
SECRET_KEY=change-this-to-a-very-secure-random-string

# PostgreSQL Database (Internal docker service: kalodata-db)
DATABASE_URL=postgresql+psycopg://kalodata:kalodata_password@kalodata-db:5432/kalodata

# Redis Queue & Lock (Internal docker service: kalodata-redis)
REDIS_URL=redis://kalodata-redis:6379/0

# Timezone & Kalodata Settings
TZ=Asia/Jakarta
KALODATA_BASE_URL=https://www.kalodata.com
KALODATA_UI_LANGUAGE=en

# VNC & Browser Settings inside Container
KALODATA_DISPLAY=:1
KALODATA_HEADLESS=false
CHROME_PROFILE_HOST_DIR=/home/kurma/Service/app-scraper-affiliator-tiktok/chrome_profile_my

# Storage & Network
RUNTIME_DIR=runtime
WEB_PORT=8081
LOG_LEVEL=INFO
WEBHOOK_URL=
