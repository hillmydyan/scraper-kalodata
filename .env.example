APP_ENV=production
SECRET_KEY=change-this-to-a-very-secure-random-string

# PostgreSQL Database (Host 5433 to avoid conflict with existing 5432)
DATABASE_URL=postgresql+psycopg://kalodata:kalodata_password@127.0.0.1:5433/kalodata

# Redis Queue & Lock (Host 6380 to avoid conflict with default Redis 6379)
REDIS_URL=redis://127.0.0.1:6380/0

# Timezone & Kalodata Settings
TZ=Asia/Jakarta
KALODATA_BASE_URL=https://www.kalodata.com
KALODATA_UI_LANGUAGE=en

# VNC Display configuration (:1 maps to port 5901)
KALODATA_DISPLAY=:1
KALODATA_HEADLESS=false

# Storage & Network
RUNTIME_DIR=runtime
WEB_PORT=8081
LOG_LEVEL=INFO
WEBHOOK_URL=
